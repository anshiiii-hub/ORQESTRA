{
  "$defs": {
    "AgentFailure": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "unknown_agent",
            "disabled_agent",
            "capability_mismatch",
            "incompatible_version",
            "permission_denied",
            "invalid_input",
            "invalid_result",
            "execution_failed",
            "deadline_exceeded",
            "output_limit_exceeded"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "stage": {
          "enum": [
            "dispatch",
            "input",
            "execution",
            "output"
          ],
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "code",
        "stage",
        "message"
      ],
      "title": "AgentFailure",
      "type": "object"
    },
    "JsonValue": {},
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_type": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Agent Type",
      "type": "string"
    },
    "agent_version": {
      "const": "1.0.0",
      "title": "Agent Version",
      "type": "string"
    },
    "artifact_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
        "type": "string"
      },
      "maxItems": 20,
      "title": "Artifact Ids",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentFailure"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "request_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_refs": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
        "type": "string"
      },
      "maxItems": 25,
      "title": "Source Refs",
      "type": "array"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "structured_output": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Structured Output"
    },
    "summary": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "task_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Task Id",
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Warnings",
      "type": "array"
    },
    "workflow_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "workflow_id",
    "task_id",
    "agent_type",
    "agent_version",
    "status",
    "summary"
  ],
  "title": "AgentResult",
  "type": "object"
}
