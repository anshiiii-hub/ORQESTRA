# Copy to .env.production on the deployment host and edit there. Do not commit secrets.
PUBLIC_DOMAIN=orqestra.example.net
PUBLIC_ORIGIN=https://orqestra.example.net
ACME_EMAIL=ops@example.net
DB_PASSWORD_SECRET_PATH=./.secrets/postgres_password
BACKUP_ENCRYPTION_PASSPHRASE_FILE=./.secrets/backup_passphrase

# Keep paid or network-enabled features off until their operational controls are reviewed.
LLM_PLANNER_ENABLED=false
RESEARCH_ENABLED=false
SANDBOX_ENABLED=false

# Optional integrations. Keep disabled until their service and security boundary are ready.
# Store OPENAI_API_KEY in the operator's protected environment, not in this template.
LLM_MODEL=
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=
LLM_MAX_OUTPUT_TOKENS=2048
RESEARCH_ALLOWED_DOMAINS=
SANDBOX_DOCKER_HOST=
SANDBOX_DOCKER_TLS_VERIFY=1
SANDBOX_DOCKER_CERT_PATH=/run/sandbox-docker-certs
SANDBOX_DOCKER_CERTS_HOST_PATH=./.secrets/sandbox-docker-certs
