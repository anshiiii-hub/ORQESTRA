# Copy to .env.production on the deployment host and edit there. Do not commit secrets.
PUBLIC_DOMAIN=orqestra.example.net
PUBLIC_ORIGIN=https://orqestra.example.net
ACME_EMAIL=ops@example.net
DB_PASSWORD_SECRET_PATH=./.secrets/postgres_password
BACKUP_ENCRYPTION_PASSPHRASE_FILE=./.secrets/backup_passphrase

# Keep paid or network-enabled features off until their operational controls are reviewed.
LLM_PLANNER_ENABLED=false
RESEARCH_ENABLED=false
SANDBOX_ENABLED=false
